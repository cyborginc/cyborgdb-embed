# ONNX Runtime source + build tree (multi-GB, fetched by scripts/build_ort.sh)
.ort/

# CMake
build/
build-*/
cmake-build-*/
CMakeUserPresets.json

# Python (parity + export tooling)
__pycache__/
*.pyc
.venv/
.venv-*/

# Working documents, deliberately untracked
SPEC.md
PLAN.md

# Local artifacts
*.log
.DS_Store

# Rust builds
target/

# Regenerated by the parity harness on every run.
tests/data/golden/**/embed-*
tests/data/golden/**/ort-*
tests/data/parity-summary.json

# Artifact downloads, keyed by release tag
.artifacts/

# Locally built archives; the published ones come from a release.
onnxruntime/prebuilt/
tokenizer/prebuilt/

tests/data/golden/*/
!tests/data/golden/BAAI_bge-small-en-v1.5/
!tests/data/golden/intfloat_e5-small-v2/
!tests/data/golden/intfloat_multilingual-e5-small/
